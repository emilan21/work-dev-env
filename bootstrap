#!/usr/bin/env python3
"""Explicitly fetch pinned plugins and compile syntax parsers. No Brew installs."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent


def run(*args):
    subprocess.run(args, check=True)


def checkout(url, commit, destination):
    if not destination.exists():
        destination.parent.mkdir(parents=True, exist_ok=True)
        run('git', 'clone', '--filter=blob:none', url, str(destination))
    if not (destination / '.git').is_dir():
        raise ValueError(f'Refusing non-Git directory: {destination}')
    remote = subprocess.check_output(['git', '-C', str(destination), 'remote', 'get-url', 'origin'], text=True).strip()
    if remote != url:
        raise ValueError(f'Unexpected plugin remote: {destination}')
    if subprocess.check_output(['git', '-C', str(destination), 'status', '--porcelain'], text=True).strip():
        raise ValueError(f'Plugin has local changes: {destination}')
    run('git', '-C', str(destination), 'fetch', '--depth', '1', 'origin', commit)
    run('git', '-C', str(destination), 'checkout', '--detach', commit)


def main():
    for tool in ('git', 'nvim', 'cc', 'tree-sitter'):
        if not shutil.which(tool):
            raise ValueError(f'Missing {tool}; install Brewfile and Apple Command Line Tools first')
    if (Path.home() / '.config/nvim').resolve() != (ROOT / 'config/nvim').resolve():
        raise ValueError('Run ./install first (or use a temporary HOME for verification)')
    os.umask(0o077)
    for name in ('resurrect', 'backups'):
        path = Path.home() / '.local/state/work-dev-env' / name
        path.mkdir(parents=True, exist_ok=True)
        path.chmod(0o700)
    lock = json.loads((ROOT / 'plugins.json').read_text())
    for name, spec in lock.items():
        destination = (Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
                       / ('nvim/lazy/' + name if name in ('lazy.nvim', 'LazyVim') else 'work-dev-env/' + name))
        checkout(spec['url'], spec['commit'], destination)
    os.environ['WORK_ENV_BOOTSTRAP'] = '1'
    run('nvim', '--headless', '+Lazy! restore', '+qa')
    os.environ['WORK_ENV_SCRIPT'] = str(ROOT / 'scripts/parsers.lua')
    run('nvim', '--headless', '-c', 'lua dofile(' + json.dumps(str(ROOT / 'scripts/run.lua')) + ')', '+qa')
    os.environ.pop('WORK_ENV_BOOTSTRAP', None)
    os.environ['WORK_ENV_SCRIPT'] = str(ROOT / 'scripts/smoke.lua')
    run('nvim', '--headless', '-c', 'lua dofile(' + json.dumps(str(ROOT / 'scripts/run.lua')) + ')', '+qa')
    print('Dependencies ready. Open Neovim and run :LazyHealth.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
